# --- FortyGuard Temperature API -------------------------------------------
# Leave the key blank to run the offline replay demo.
FORTYGUARD_API_KEY=
DATA_MODE=auto              # auto | live | replay

# Confirm these with `python -m tools.probe_api` once your key works.
FG_BASE_URL=https://api.fortyguard.com/v1
FG_SUBMIT_PATH=/heatmap
FG_POLL_PATH=/status/{activity_id}
FG_AUTH_HEADER=api-key
FG_UNITS=c                  # units the API actually returns: c or f
FG_GRANULARITY=100          # metres per cell
FG_AOI_SIDE_M=200           # worksite bounding box side length
FG_AOI_RETRY_M=1000         # wider fallback box, used only when the first try returns 0 tiles
FG_FILTER_CURRENT=1
FG_FILTER_FORECAST=2
FG_FILTER_HISTORICAL=3

# --- Agent -----------------------------------------------------------------
POLL_ENABLED=false
POLL_INTERVAL_S=300
LOOKAHEAD_HOURS=12
HEARTBEAT_MINUTES=60

# --- Demo ------------------------------------------------------------------
# Pin the synthetic curve to 09:00 local so afternoon crossings sit ahead of you
# and the pre-breach advisories can be seen firing. Replay mode only.
REPLAY_PIN_HOUR=9

# --- Notifications ---------------------------------------------------------
NOTIFY_CONSOLE=true
SLACK_WEBHOOK_URL=

# --- Station baseline ------------------------------------------------------
# api.weather.gov requires a descriptive User-Agent with a real contact address.
NWS_USER_AGENT=ThresholdGuard/0.1 (hackathon; contact: you@example.com)

# ── API quota management ──────────────────────────────────────────────────────
# FortyGuard free tier: 30 heatmaps/day.
# 1 site = 1 heatmap per scan (LOOKAHEAD_HOURS=0).
# With 3 sites and POLL_INTERVAL_S=21600 (6h), you use 3 * 4 = 12 heatmaps/day.
# Increase LOOKAHEAD_HOURS only if you have more quota.
LOOKAHEAD_HOURS=0
POLL_INTERVAL_S=21600
